generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  uuid             String         @unique @default(uuid())
  tenantId         Int?
  name             String
  email            String         @unique
  phone            String?
  password         String
  roleId           Int
  avatar           String?
  status           String         @default("active")
  vacationBalance  Int            @default(0)
  lastLogin        DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  bankingInfo      String?        @db.LongText
  birthday         DateTime?
  employmentStatus String?
  hasLicense       Boolean        @default(false)
  hasNIB           Boolean        @default(false)
  hasPassport      Boolean        @default(false)
  hasResume        Boolean        @default(false)
  nibNumber        String?
  auditLogs        AuditLog[]
  employee         Employee?
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  userRoles        UserRole[]
  role             Role           @relation(fields: [roleId], references: [id])
  tenant           Tenant?        @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@index([tenantId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_userId_fkey")
  @@map("refresh_tokens")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roleMenus       RoleMenu[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String
  module          String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@index([permissionId], map: "role_permissions_permissionId_fkey")
  @@index([roleId], map: "role_permissions_roleId_fkey")
  @@map("role_permissions")
}

model Menu {
  id        Int        @id @default(autoincrement())
  name      String
  path      String
  icon      String
  module    String?
  roleMenus RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  id         Int     @id @default(autoincrement())
  roleId     Int
  menuId     Int
  can_view   Boolean @default(false)
  can_add    Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)
  menu       Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@index([menuId], map: "role_menus_menuId_fkey")
  @@map("role_menus")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@index([roleId], map: "user_roles_roleId_fkey")
  @@index([userId], map: "user_roles_userId_fkey")
  @@map("user_roles")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String   @db.Text
  type      String
  userId    Int
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  module      String
  action      String
  description String?
  oldValue    String?  @db.LongText
  newValue    String?  @db.LongText
  performedBy Int
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [performedBy], references: [id])

  @@index([performedBy], map: "audit_logs_performedBy_fkey")
  @@map("audit_logs")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  group     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?        @db.Text
  price         Float
  billingCycle  String
  maxUsers      Int
  maxStorage    Int
  features      String?        @db.LongText
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   String?  @db.Text
  country   String?
  timezone  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants   Tenant[]

  @@index([email])
  @@index([status])
  @@map("organizations")
}

model Tenant {
  id                 Int                @id @default(autoincrement())
  organizationId     Int
  subscriptionId     Int?               @unique
  tenantCode         String             @unique
  status             String             @default("active")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clientContacts     ClientContact[]
  clients            Client[]
  deliveries         Delivery[]
  deliveryItems      DeliveryItem[]
  departments        Department[]
  designations       Designation[]
  employeeDocs       EmployeeDocument[]
  employees          Employee[]
  grns               GRN[]
  inventoryStock     InventoryStock[]
  invoiceItems       InvoiceItem[]
  invoices           Invoice[]
  itemCategories     ItemCategory[]
  itemUnits          ItemUnit[]
  items              Item[]
  missions           Mission[]
  orderItems         OrderItem[]
  orders             Order[]
  payments           Payment[]
  proofsOfDelivery   ProofOfDelivery[]
  purchaseOrders     PurchaseOrder[]
  purchaseReqs       PurchaseRequest[]
  quotations         Quotation[]
  receipts           Receipt[]
  rfqs               RFQ[]
  stockMovements     StockMovement[]
  subscriptions      Subscription[]     @relation("TenantSubscriptions")
  organization       Organization       @relation(fields: [organizationId], references: [id])
  activeSubscription Subscription?      @relation("ActiveSubscription", fields: [subscriptionId], references: [id])
  users              User[]
  vehicles           Vehicle[]
  vendors            Vendor[]
  warehouses         Warehouse[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([tenantCode])
  @@index([status])
  @@map("tenants")
}

model Subscription {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  planId          Int
  startDate       DateTime
  endDate         DateTime
  status          String
  paymentStatus   String
  autoRenew       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  plan            Plan     @relation(fields: [planId], references: [id])
  tenant          Tenant   @relation("TenantSubscriptions", fields: [tenantId], references: [id])
  activeForTenant Tenant?  @relation("ActiveSubscription")

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Department {
  id           Int               @id @default(autoincrement())
  tenantId     Int
  name         String
  code         String
  description  String?           @db.Text
  status       String            @default("active")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  designations Designation[]
  employees    Employee[]
  purchaseReqs PurchaseRequest[]

  @@index([tenantId])
  @@index([code])
  @@index([status])
  @@map("departments")
}

model Designation {
  id           Int        @id @default(autoincrement())
  tenantId     Int
  departmentId Int
  name         String
  description  String?    @db.Text
  status       String     @default("active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  employees    Employee[]

  @@index([tenantId])
  @@index([departmentId])
  @@index([status])
  @@map("designations")
}

model Employee {
  id                 Int                @id @default(autoincrement())
  tenantId           Int
  userId             Int                @unique
  employeeCode       String
  firstName          String
  lastName           String
  phone              String?
  departmentId       Int
  designationId      Int
  joiningDate        DateTime
  status             String             @default("active")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  vehicleModel       String?
  vehiclePlate       String?
  vehicleType        String?
  assignedDeliveries Delivery[]         @relation("DeliveryAssignee")
  documents          EmployeeDocument[]
  department         Department         @relation(fields: [departmentId], references: [id])
  designation        Designation        @relation(fields: [designationId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  grnsReceived       GRN[]              @relation("GRNReceiver")
  assignedMissions   Mission[]          @relation("MissionAssignee")
  ordersCreated      Order[]            @relation("OrderCreator")
  purchaseReqs       PurchaseRequest[]
  managedWarehouses  Warehouse[]        @relation("WarehouseManager")

  @@index([tenantId])
  @@index([employeeCode])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@map("employees")
}

model Vendor {
  id             Int             @id @default(autoincrement())
  tenantId       Int
  vendorCode     String
  companyName    String
  contactPerson  String?
  email          String
  phone          String?
  address        String?         @db.Text
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       String?
  delivery       Int?            @default(90)
  rating         Int?            @default(90)
  grns           GRN[]
  purchaseOrders PurchaseOrder[]
  quotations     Quotation[]
  rfqs           RFQ[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([vendorCode])
  @@index([status])
  @@map("vendors")
}

model EmployeeDocument {
  id                 Int       @id @default(autoincrement())
  tenantId           Int
  employeeId         Int
  documentType       String
  documentNumber     String?
  filePath           String
  verificationStatus String    @default("pending")
  verifiedBy         Int?
  verifiedAt         DateTime?
  expiryDate         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  employee           Employee  @relation(fields: [employeeId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([verificationStatus])
  @@map("employee_documents")
}

model PurchaseRequest {
  id             Int                   @id @default(autoincrement())
  tenantId       Int
  prNumber       String
  title          String
  description    String?               @db.Text
  departmentId   Int
  requestedBy    Int
  status         String                @default("draft")
  priority       String                @default("medium")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  purchaseOrders PurchaseOrder[]
  items          PurchaseRequestItem[]
  department     Department            @relation(fields: [departmentId], references: [id])
  requester      Employee              @relation(fields: [requestedBy], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  rfqs           RFQ[]

  @@index([tenantId])
  @@index([prNumber])
  @@index([status])
  @@index([departmentId])
  @@index([requestedBy])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int
  itemName          String
  description       String?         @db.Text
  quantity          Float
  unit              String
  estimatedCost     Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@map("purchase_request_items")
}

model RFQ {
  id                Int             @id @default(autoincrement())
  tenantId          Int
  rfqNumber         String
  purchaseRequestId Int
  vendorId          Int
  status            String          @default("sent")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  quotations        Quotation[]
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  vendor            Vendor          @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([rfqNumber])
  @@index([purchaseRequestId])
  @@index([vendorId])
  @@index([status])
  @@map("rfqs")
}

model Quotation {
  id             Int             @id @default(autoincrement())
  tenantId       Int
  rfqId          Int
  vendorId       Int
  amount         Float
  remarks        String?         @db.Text
  status         String          @default("pending")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  rfq            RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  vendor         Vendor          @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([rfqId])
  @@index([vendorId])
  @@index([status])
  @@map("quotations")
}

model PurchaseOrder {
  id                Int             @id @default(autoincrement())
  tenantId          Int
  poNumber          String
  vendorId          Int
  purchaseRequestId Int
  quotationId       Int?
  totalAmount       Float
  status            String          @default("draft")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  grns              GRN[]
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  quotation         Quotation?      @relation(fields: [quotationId], references: [id])
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  vendor            Vendor          @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([poNumber])
  @@index([vendorId])
  @@index([purchaseRequestId])
  @@index([status])
  @@index([quotationId], map: "purchase_orders_quotationId_fkey")
  @@map("purchase_orders")
}

model ItemCategory {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?  @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  items       Item[]

  @@index([tenantId])
  @@map("item_categories")
}

model ItemUnit {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String
  shortName String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  items     Item[]

  @@index([tenantId])
  @@map("item_units")
}

model Item {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  categoryId     Int
  unitId         Int
  sku            String
  name           String
  description    String?          @db.Text
  reorderLevel   Float            @default(0)
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  inventoryType  String           @default("INTERNAL")
  deliveryItems  DeliveryItem[]
  grnItems       GRNItem[]
  inventoryStock InventoryStock[]
  invoiceItems   InvoiceItem[]
  category       ItemCategory     @relation(fields: [categoryId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  unit           ItemUnit         @relation(fields: [unitId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([unitId])
  @@index([sku])
  @@map("items")
}

model Warehouse {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  name           String
  location       String?          @db.Text
  managerId      Int?
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  capacity       Int?             @default(0)
  deliveries     Delivery[]
  grns           GRN[]
  inventoryStock InventoryStock[]
  stockMovements StockMovement[]
  manager        Employee?        @relation("WarehouseManager", fields: [managerId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([managerId])
  @@map("warehouses")
}

model GRN {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  grnNumber       String
  purchaseOrderId Int
  vendorId        Int
  warehouseId     Int
  receivedById    Int
  deliveryChallan String?
  remarks         String?         @db.Text
  status          String          @default("draft")
  receivedDate    DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           GRNItem[]
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  receiver        Employee        @relation("GRNReceiver", fields: [receivedById], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  stockMovements  StockMovement[]

  @@index([tenantId])
  @@index([grnNumber])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([warehouseId])
  @@index([status])
  @@index([receivedById], map: "grns_receivedById_fkey")
  @@map("grns")
}

model GRNItem {
  id               Int      @id @default(autoincrement())
  grnId            Int
  itemId           Int
  orderedQuantity  Float
  receivedQuantity Float
  acceptedQuantity Float
  rejectedQuantity Float    @default(0)
  unitPrice        Float
  totalPrice       Float
  remarks          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  grn              GRN      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id])

  @@index([grnId])
  @@index([itemId])
  @@map("grn_items")
}

model InventoryStock {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  warehouseId      Int
  itemId           Int
  quantity         Float     @default(0)
  reservedQuantity Float     @default(0)
  lastUpdated      DateTime  @default(now()) @updatedAt
  stockType        String    @default("INTERNAL")
  item             Item      @relation(fields: [itemId], references: [id])
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, itemId])
  @@index([tenantId])
  @@index([itemId], map: "inventory_stock_itemId_fkey")
  @@map("inventory_stock")
}

model StockMovement {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  warehouseId   Int
  itemId        Int
  movementType  String
  quantity      Float
  referenceType String
  referenceId   Int?
  remarks       String?   @db.Text
  createdAt     DateTime  @default(now())
  grn           GRN?      @relation(fields: [referenceId], references: [id], map: "stock_movement_grn_fk")
  item          Item      @relation(fields: [itemId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([warehouseId])
  @@index([itemId])
  @@index([movementType])
  @@index([referenceId], map: "stock_movement_grn_fk")
  @@map("stock_movements")
}

model Client {
  id            Int             @id @default(autoincrement())
  tenantId      Int
  clientCode    String          @unique
  companyName   String
  contactPerson String
  email         String
  phone         String
  address       String?         @db.Text
  city          String?
  country       String?
  status        String          @default("active")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  billingCycle  String?
  clientType    String?
  logoUrl       String?         @db.Text
  paymentMethod String?
  plan          String?
  source        String?
  contacts      ClientContact[]
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  deliveries    Delivery[]
  invoices      Invoice[]
  orders        Order[]

  @@index([tenantId])
  @@index([clientCode])
  @@map("clients")
}

model ClientContact {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  clientId    Int
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("client_contacts")
}

model Order {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  orderNumber String
  clientId    Int
  createdById Int
  status      String      @default("draft")
  priority    String      @default("normal")
  totalAmount Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  metadata    String?     @db.LongText
  orderType   String      @default("PRODUCT")
  deliveries  Delivery[]
  invoices    Invoice[]
  missions    Mission[]
  items       OrderItem[]
  client      Client      @relation(fields: [clientId], references: [id])
  creator     Employee    @relation("OrderCreator", fields: [createdById], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderNumber])
  @@index([clientId])
  @@index([status])
  @@index([createdById], map: "orders_createdById_fkey")
  @@map("orders")
}

model OrderItem {
  id            Int            @id @default(autoincrement())
  tenantId      Int
  orderId       Int
  itemId        Int
  warehouseId   Int
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliveryItems DeliveryItem[]
  item          Item           @relation(fields: [itemId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([itemId])
  @@index([warehouseId])
  @@map("order_items")
}

model Delivery {
  id             Int               @id @default(autoincrement())
  tenantId       Int
  deliveryNumber String
  orderId        Int
  clientId       Int
  assignedTo     Int?
  warehouseId    Int
  status         String            @default("pending")
  dispatchDate   DateTime?
  deliveryDate   DateTime?
  remarks        String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveryFee    Float?
  dropLocation   String?
  dueDate        DateTime?
  etaSchedule    DateTime?
  missionType    String            @default("Delivery")
  pickupLocation String?
  requestDate    DateTime?
  routeDistance  Float?
  staffPayRate   Float?
  transportMode  String            @default("Road")
  vehicleRef     String?
  assignee       Employee?         @relation("DeliveryAssignee", fields: [assignedTo], references: [id])
  client         Client            @relation(fields: [clientId], references: [id])
  order          Order             @relation(fields: [orderId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  items          DeliveryItem[]
  invoices       Invoice[]
  missions       Mission[]
  proofs         ProofOfDelivery[]

  @@index([tenantId])
  @@index([deliveryNumber])
  @@index([orderId])
  @@index([clientId])
  @@index([assignedTo])
  @@index([warehouseId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryItem {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  deliveryId  Int
  orderItemId Int
  itemId      Int
  quantity    Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([deliveryId])
  @@index([orderItemId])
  @@index([itemId])
  @@map("delivery_items")
}

model Mission {
  id                 Int       @id @default(autoincrement())
  tenantId           Int
  missionNumber      String
  deliveryId         Int?
  assignedEmployeeId Int
  startDate          DateTime?
  endDate            DateTime?
  status             String    @default("assigned")
  remarks            String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  metadata           String?   @db.LongText
  missionType        String    @default("DELIVERY")
  orderId            Int?
  assignee           Employee  @relation("MissionAssignee", fields: [assignedEmployeeId], references: [id])
  delivery           Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order              Order?    @relation(fields: [orderId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([missionNumber])
  @@index([deliveryId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([orderId], map: "missions_orderId_fkey")
  @@map("missions")
}

model ProofOfDelivery {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  deliveryId        Int
  receiverName      String
  receiverPhone     String?
  receiverSignature String?  @db.Text
  deliveryPhoto     String?  @db.Text
  remarks           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  delivery          Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([deliveryId])
  @@map("proof_of_delivery")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  tenantId       Int
  invoiceNumber  String
  clientId       Int
  orderId        Int
  deliveryId     Int
  invoiceDate    DateTime
  dueDate        DateTime
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  totalAmount    Float         @default(0)
  status         String        @default("draft")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          InvoiceItem[]
  client         Client        @relation(fields: [clientId], references: [id])
  delivery       Delivery      @relation(fields: [deliveryId], references: [id])
  order          Order         @relation(fields: [orderId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  payments       Payment[]

  @@index([tenantId])
  @@index([invoiceNumber])
  @@index([clientId])
  @@index([orderId])
  @@index([deliveryId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  invoiceId Int
  itemId    Int
  quantity  Float
  unitPrice Float
  tax       Float    @default(0)
  discount  Float    @default(0)
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_items")
}

model Payment {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  invoiceId       Int
  paymentDate     DateTime
  paymentMethod   String
  referenceNumber String?
  amount          Float
  remarks         String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  receipts        Receipt[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([referenceNumber])
  @@index([paymentMethod])
  @@map("payments")
}

model Receipt {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  receiptNumber String
  paymentId     Int
  receiptDate   DateTime
  amount        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([receiptNumber])
  @@index([paymentId])
  @@map("receipts")
}

model Vehicle {
  id                 Int      @id @default(autoincrement())
  vehicleId          String
  type               String   @default("Luxury Truck")
  model              String
  capacity           String?
  fuel               String?
  status             String   @default("Active")
  location           String?
  insurancePolicy    String?
  registrationExpiry String?
  inspectionDate     String?
  diagnosticStatus   String?
  tenantId           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([vehicleId, tenantId])
  @@index([tenantId])
  @@map("vehicles")
}
